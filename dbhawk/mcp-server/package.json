{
  "name": "@dbhawk/mcp",
  "version": "7.1.1",
  "description": "MCP server bridging an AI assistant to the DBHawk /api/v2/mcp REST API (datasource exploration, tier-gated SQL execution + DBHawk AI).",
  "mcpName": "com.datasparc/dbhawk",
  "type": "module",
  "bin": {
    "dbhawk-mcp": "dist/dbhawk-mcp.mjs"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Datasparc/dbhawk-mcp-plugin.git",
    "directory": "dbhawk/mcp-server"
  },
  "homepage": "https://github.com/Datasparc/dbhawk-mcp-plugin#readme",
  "keywords": [
    "mcp",
    "dbhawk",
    "database",
    "sql",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --format=esm --loader:.html=text --outfile=dist/dbhawk-mcp.mjs",
    "start": "npm run build && node dist/dbhawk-mcp.mjs",
    "test": "npm run build && node --test",
    "test:only": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "esbuild": "^0.28.2",
    "zod": "^3.23.8"
  }
}
