{
  "mcpServers": {
    "dbhawk": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-server/dist/dbhawk-mcp.mjs"],
      "env": {
        "DBHAWK_BASE_URL": "${DBHAWK_BASE_URL:-https://your-dbhawk.example.com}",
        "DBHAWK_TOKEN": "${DBHAWK_TOKEN}",
        "DBHAWK_DEFAULT_DATASOURCE": "${DBHAWK_DEFAULT_DATASOURCE:-}"
      }
    }
  }
}
