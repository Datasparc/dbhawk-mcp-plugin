# Copy to .env (or export these in your shell) before launching the MCP server.
# Never commit a real token.

# Base URL of the DBHawk stand, WITHOUT a trailing /api. The server appends /api/v2/mcp itself.
DBHAWK_BASE_URL=https://your-dbhawk.example.com

# MCP-scoped personal token (dbh_<id>.<secret>): DBHawk -> User Profile -> API Token.
# This is NOT a JWT - paste the personal token as-is; the server exchanges it for a JWT at runtime.
DBHAWK_TOKEN=paste-your-mcp-token-here

# Optional: datasource used when a tool call omits "datasource".
DBHAWK_DEFAULT_DATASOURCE=
